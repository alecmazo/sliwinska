{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/corporate-site", "destination": "/corporate-packages/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
